[resource]
script = ExtResource("1_jccg5")
text = "Alors que crainte et désir d’affrontement se mélangeaient dans l’esprit des {tribe_name}, les attaques sur les Espagnols se sont répétées. Les conquistadors enterrent les cadavres de leurs camarades et se hâtent de quitter ces terres."
types_text = 2
type_choice = "a2b"
calcul_troops = "-(0.01 * tribe_number)"
