[resource]
script = ExtResource("1_jccg5")
text = "Les {tribe_name} n’avaient pas une volonté belliqueuse assez forte envers les étrangers.Quelques attaques éparses ont entraîné la mort de conquistadors, mais les Espagnols craignent tout de même plus les maladies que ces guerriers peu motivés."
