[resource]
script = ExtResource("1_no7jg")
text = "La guérilla des {tribe_name} aura eu raison des dernières forces espagnoles dont les corps découpés servent de décoration dans les arbres. Il ne reste personne pour raconter leur fin funeste et leur cupide rêve de richesse se termine en cauchemar."
