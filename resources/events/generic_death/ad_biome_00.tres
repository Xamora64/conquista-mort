[resource]
script = ExtResource("1_jccg5")
text = "Aucun homme ne revint de cette expédition. Le nouveau monde aura dévoré leurs âmes cupides, et peut-être aussi loups et alligators.Les chefferies trouveront leurs corps et se remémoreront les souvenirs douloureux de leurs rencontres avec ces européens, avant que d’autres ne débarquent bien sûr."
