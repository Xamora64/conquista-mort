[resource]
script = ExtResource("1_jccg5")
text = "Alors que la végétation change et que les Espagnols se mettent à remettre en question les choix du guide, celui-ci disparaît au détour d’un fourré. Les conquistadors comprennent alors avoir été bernés tandis que le {tribe_name} rie en imaginant leurs visages décomposés."
